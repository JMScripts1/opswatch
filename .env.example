# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=opswatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=opswatch
DATABASE_URL=postgresql+psycopg://opswatch:change-me@db:5432/opswatch

# Shared secret agents send in the X-Agent-Token header
AGENT_TOKEN=change-me-too

# Optional: Discord/Slack-compatible incoming webhook for alerts + daily report
WEBHOOK_URL=
# Daily report time (24h, server local time)
REPORT_HOUR=8
